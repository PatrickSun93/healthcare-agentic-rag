# Copy to .env and edit. Defaults run fully local via Ollama.

# Providers: ollama (local, PHI-safe) | openai | anthropic
LLM_PROVIDER=ollama
EMBED_PROVIDER=ollama

# Ollama (local) — start with `ollama serve`, then pull the models below
OLLAMA_BASE=http://localhost:11434
EMBED_MODEL=nomic-embed-text
LLM_MODEL=llama3.1

# API fallbacks (only needed if you switch providers)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Vector store: qdrant (local) | pinecone (managed)
VECTOR_BACKEND=qdrant
QDRANT_URL=http://localhost:6333
COLLECTION=healthcare_rag
# Pinecone (only if VECTOR_BACKEND=pinecone)
PINECONE_API_KEY=
PINECONE_INDEX=healthcare-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Retrieval
TOP_K_DENSE=20
TOP_K_SPARSE=20
FINAL_K=5
RRF_K=60
RERANK=false            # true => cross-encoder rerank (needs sentence-transformers)

# Chunking (approx word-based tokens)
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP=60

# PDF ingestion / OCR for scanned pages
OCR_BACKEND=tesseract       # tesseract | ollama | none
OCR_VISION_MODEL=llama3.2-vision
OCR_MIN_CHARS=20            # a page with fewer chars than this is treated as scanned -> OCR
OCR_DPI=200
